# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# `.env` sürüm kontrolüne girmez.

# ------------------------------------------------------------- Uygulama
ENVIRONMENT=development
DEBUG=true

# ----------------------------------------------------------- Veritabanı
# Yerel geliştirme: proje dizininde `test.db` dosyası oluşur.
# PostgreSQL için: postgresql+asyncpg://stopkoc:stopkoc@localhost:5432/stopkoc
DATABASE_URL=sqlite+aiosqlite:///./test.db
DB_ECHO=false

# ------------------------------------------------------------- Güvenlik
# Üretimde zorunlu: en az 32 karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

# 7 gün (mobil uygulamanın sık sık giriş istememesi için)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# bcrypt maliyeti (4-16). Üretimde 12 iyi bir denge.
BCRYPT_ROUNDS=12

# Virgülle ayrılmış kaynak listesi. Üretimde `*` kullanılamaz.
CORS_ORIGINS=*

# --------------------------------------------------- Ollama / Llama 3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Fotoğraflı sorgular için görme yeteneği olan model
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=512

# AI uçları yalnızca AI Pro paketi olan kullanıcılara açık olsun mu?
# Geliştirme sırasında false yapılabilir.
AI_REQUIRES_SUBSCRIPTION=true
